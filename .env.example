# Copy to .env and change the password. .env is gitignored.
# Read by docker-compose.yml and by the backend `local` Spring profile.
POSTGRES_DB=deploykit
POSTGRES_USER=deploykit
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Authentication (Phase 9). The backend refuses to start without a JWT secret.
# Generate one with: openssl rand -base64 48
DEPLOYKIT_JWT_SECRET=change-me-with-at-least-32-characters
# First administrator, created at startup if it does not exist yet (password: 12+ characters).
DEPLOYKIT_ADMIN_EMAIL=admin@example.com
DEPLOYKIT_ADMIN_PASSWORD=change-me-too-12-chars-min
